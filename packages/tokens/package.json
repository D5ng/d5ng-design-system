{
  "name": "@d5ng/tokens",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "vite build && cp src/generated/tokens.css dist/tokens.css",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}
